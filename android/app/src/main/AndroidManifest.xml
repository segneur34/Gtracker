<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ni sauvegarde Google ni transfert d'appareil : le dossier mémoire est la seule sauvegarde. allowBackup="false"
         n'arrête pas le transfert d'appareil sous Android 12 ou plus, d'où les règles, qui excluent tout des deux. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="31">

        <!-- configChanges : ni rotation, ni taille ou graisse du texte du téléphone (fontScale, fontWeightAdjustment) ne
             recréent l'activité, qui couperait l'enregistrement en cours. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale|fontWeightAdjustment"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- « Ouvrir avec Gtracker » d'un GPX ou d'un FIT (IncomingFilePlugin). Gtracker apparaît dans le choix d'Android, sans en
                 devenir l'application par défaut ; la signature du fichier est vérifiée à la réception, un type ne prouve rien. Pas de
                 BROWSABLE : une page web ne peut pas pousser de fichier. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/fit" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>

            <!-- « Ouvrir avec » d'un .gpx dont le gestionnaire de fichiers donne un type inattendu (text/plain, application/gpx,
                 type vide ou générique selon l'application) : Gtracker est proposé d'après l'extension du nom. Forme connue d'Android
                 (type générique, hôte joker, motifs de chemin), limitée au GPX ; le JSON n'est jamais proposé. Seul content:// : la
                 réception refuse file://. Le FIT passe par ses types, plus fiables. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\.GPX" />
            </intent-filter>

            <!-- « Partager vers Gtracker » : le fichier est dans EXTRA_STREAM, l'intention n'a pas d'adresse. Déclarer un schéma ici
                 l'empêcherait d'entrer (règle des filtres d'Android). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/fit" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Service de l'enregistrement (RecordingService) : au premier plan, de type position, démarré seulement par
             l'application visible. stopWithTask="false" : balayer l'application hors des applications récentes ne l'arrête pas. -->
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vibrations du guidage vers les balises (BeeperPlugin) : permission normale, sans demande. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Enregistrement : position du GPS, demandée à l'utilisateur, service au premier plan de type position
         (RecordingService), processeur éveillé, notification lisible écran verrouillé (RecordingNotificationPlugin).
         Jamais la position « toujours » : le service ne démarre que depuis l'application visible. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- L'application ne sert à rien sans GPS : même exigence que celle du greffon de position d'avant. -->
    <uses-feature android:name="android.hardware.location.gps" />
    <!-- « Réessayer » du GPS (GnssPlugin) : recharger les données d'aide au GPS, sans jamais les effacer ; permission
         normale, sans demande. -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />
    <!-- Ceinture cardio (HeartRatePlugin) : recherche et connexion Bluetooth, sans en tirer de position. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Carte « Autorisations » (PermissionsPlugin) : l'écran système qui lève l'optimisation de la batterie. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Liaison sans fil avec le programme Windows (ComputerLinkPlugin) : lire les réseaux du téléphone pour écarter
         le réseau mobile ; l'accès au réseau local n'est demandé qu'à partir d'Android 17 (API 37), une version plus
         ancienne ignore cette permission. La liaison passe par TLS : aucun trafic en clair n'est autorisé. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
</manifest>
